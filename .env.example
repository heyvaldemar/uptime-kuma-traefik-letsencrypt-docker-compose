# Uptime Kuma + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# UPTIME_KUMA_IMAGE_TAG=louislam/uptime-kuma:2.5.3@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.uptime.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Uptime Kuma
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
UPTIME_KUMA_HOSTNAME=uptime.example.com

# There is no password here to set. Uptime Kuma has no credentials until the
# first account exists, and it creates that account through the setup page.
# **Open the site and register immediately after deploy** — until you do, the
# first stranger who finds the hostname becomes the administrator of a
# dashboard that lists your infrastructure.

# Timezone used for heartbeat timestamps and maintenance windows.
# UPTIME_KUMA_TZ=Etc/UTC

# Allow the dashboard to be embedded in a frame on another origin. Off by
# default, which is what stops a page you did not write from framing it.
# UPTIME_KUMA_DISABLE_FRAME_SAMEORIGIN=false

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# DATA_BACKUP_PRUNE_DAYS=7
# DATA_BACKUPS_PATH=/srv/uptime-kuma-data/backups
# DATA_PATH=/app/data
# DATA_BACKUP_NAME=uptime-kuma-data-backup

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. A few hundred monitors fit in the default:
# each one is a scheduled job and a row per heartbeat.
# UPTIME_KUMA_MEMORY_LIMIT=512m
# UPTIME_KUMA_CPU_LIMIT=1.0
# UPTIME_KUMA_MEMORY_RESERVATION=128m
# UPTIME_KUMA_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# UPTIME_KUMA_BACKUPS_MEMORY_LIMIT=128m
# UPTIME_KUMA_BACKUPS_CPU_LIMIT=0.5
# UPTIME_KUMA_BACKUPS_MEMORY_RESERVATION=16m
# UPTIME_KUMA_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits before SIGKILL. Everything this service knows is one
# SQLite file, and a kill during a checkpoint leaves a write-ahead log to
# replay at best and a torn page at worst.
# UPTIME_KUMA_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# UPTIME_KUMA_IMAGE_VERSION=2.5.3
# UPTIME_KUMA_BACKUPS_IMAGE_VERSION=3.22
